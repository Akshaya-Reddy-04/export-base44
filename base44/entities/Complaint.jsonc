{
  "name": "Complaint",
  "type": "object",
  "properties": {
    "mess_id": {
      "type": "string"
    },
    "mess_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_quality",
        "hygiene",
        "service",
        "suggestion",
        "general"
      ]
    },
    "description": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "student_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "in_progress",
        "resolved"
      ],
      "default": "submitted"
    },
    "assigned_to": {
      "type": "string"
    },
    "admin_reply": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}