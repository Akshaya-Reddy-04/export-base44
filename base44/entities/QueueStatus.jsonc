{
  "name": "QueueStatus",
  "type": "object",
  "properties": {
    "mess_id": {
      "type": "string"
    },
    "mess_name": {
      "type": "string"
    },
    "waiting_students": {
      "type": "number",
      "default": 0
    },
    "counters_open": {
      "type": "number",
      "default": 1
    },
    "total_counters": {
      "type": "number",
      "default": 3
    },
    "avg_serving_seconds": {
      "type": "number",
      "default": 45
    },
    "status_note": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "mess_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}