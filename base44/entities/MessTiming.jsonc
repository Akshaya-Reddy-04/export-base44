{
  "name": "MessTiming",
  "type": "object",
  "properties": {
    "mess_id": {
      "type": "string"
    },
    "meal": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "snacks",
        "dinner"
      ]
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "mess_id",
    "meal",
    "start_time",
    "end_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}