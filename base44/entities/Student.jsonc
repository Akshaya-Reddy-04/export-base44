{
  "name": "Student",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "roll_number": {
      "type": "string"
    },
    "student_code": {
      "type": "string",
      "description": "Unique code encoded in the student's QR pass"
    },
    "email": {
      "type": "string"
    },
    "hostel": {
      "type": "string"
    },
    "mess_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "dietary_pref": {
      "type": "string",
      "enum": [
        "veg",
        "non_veg",
        "any"
      ],
      "default": "any"
    },
    "notify_queue": {
      "type": "boolean",
      "default": true
    },
    "notify_crowd": {
      "type": "boolean",
      "default": true
    },
    "notify_food": {
      "type": "boolean",
      "default": true
    },
    "notify_menu": {
      "type": "boolean",
      "default": true
    },
    "notify_browser": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "student_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}