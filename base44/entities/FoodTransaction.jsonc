{
  "name": "FoodTransaction",
  "type": "object",
  "properties": {
    "mess_id": {
      "type": "string"
    },
    "menu_item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "meal": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "prepared",
        "served",
        "wasted",
        "restocked"
      ]
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "menu_item_id",
    "type",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}